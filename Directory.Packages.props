<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DotNetKit.Wpf.AutoCompleteComboBox" Version="2.0.2" />
    <PackageVersion Include="DynamicExpresso.Core" Version="2.19.6" />
    <PackageVersion Include="EfCore.SchemaCompare" Version="10.0.0" />
    <PackageVersion Include="FileAssociation2" Version="22.12.21.18" />
    <PackageVersion Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageVersion Include="HtmlToXaml" Version="1.0.0" />
    <PackageVersion Include="IronPython" Version="3.4.2" />
    <PackageVersion Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageVersion Include="log4net" Version="3.5.0" />
    <PackageVersion Include="MahApps.Metro" Version="2.4.11" />
    <PackageVersion Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="MaterialDesignThemes.MahApps" Version="5.4.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Graph" Version="5.103.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.7705" />
    <PackageVersion Include="MimeKit" Version="4.18.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="OpenXmlPowerTools" Version="4.5.3.2" />
    <PackageVersion Include="Prism.Core" Version="9.0.537" />
    <PackageVersion Include="Prism.Plugin.Logging.Abstractions" Version="8.1.16" />
    <PackageVersion Include="Prism.Unity" Version="9.0.537" />
    <PackageVersion Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.ObjectModel" Version="4.3.0" />
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageVersion Include="Uno.UI" Version="5.6.99" />
    <PackageVersion Include="Vanara.PInvoke.User32" Version="4.2.1" />
  </ItemGroup>
</Project>
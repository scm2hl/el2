<UserControl x:Class="ModuleShift.Dialogs.ManipulationRuleEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModuleShift.Dialogs"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Speichern" Width="75" Margin="5" Command="{Binding OkDialogCommand}"/>
            <Button Content="Cancel" Width="75" Margin="5"/>
        </StackPanel>

        <TextBox Grid.Row="1" Text="{Binding RuleText}" Margin="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Add Rule" Width="100" Margin="5"/>
            <Button Content="Remove Rule" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>

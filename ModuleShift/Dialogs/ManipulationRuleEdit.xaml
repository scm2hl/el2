<UserControl x:Class="ModuleShift.Dialogs.ManipulationRuleEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModuleShift.Dialogs"
             xmlns:service="clr-namespace:ModuleShift.Services"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" MinWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" MinHeight="400"/>
            <!-- Bereich, um den aktualisierten Code im ViewModel zu demonstrieren -->
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <Button Content="Speichern" Command="{Binding OkDialogCommand}" Margin="5"/>
            <Button Content="Abbrechen" Command="{Binding CancelDialogCommand}" Margin="5"/>
        </StackPanel>
        <!-- Der Monaco Editor via WebView2 -->
        <wv2:WebView2 Grid.Row="1"
                      service:MonacoHelper.InitializeWithCode="True"
                      service:MonacoHelper.BindableCode="{Binding RuleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    </Grid>
</UserControl>
